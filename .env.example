# Copy to .env and adjust. Values below match docker-compose.yml.
# When running a service on your machine (npm run dev:*), use the "host" values.
# Inside Docker, compose overrides these with container hostnames.

NODE_ENV=development
JWT_SECRET=change-me-dev-secret

# Kafka (host listener on 9094; containers use kafka:9092)
KAFKA_BROKERS=localhost:9094

# MySQL (host port 3307 so it does not clash with a local MySQL on 3306)
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=airbnb
MYSQL_PASSWORD=airbnb
MYSQL_DATABASE=airbnb

# MongoDB (host port 27018 so it does not clash with a local MongoDB)
MONGO_URL=mongodb://localhost:27018
MONGO_DB=airbnb

# Redis
REDIS_URL=redis://localhost:6379

# Service ports
GATEWAY_PORT=8080
USER_SERVICE_PORT=8001
PROPERTY_SERVICE_PORT=8002
BOOKING_SERVICE_PORT=8003
MESSAGING_SERVICE_PORT=8004
REVIEW_SERVICE_PORT=8005
ANALYTICS_SERVICE_PORT=8006
AI_SERVICE_PORT=8007
NOTIFY_PORT=8009

# AI service
LLM_PROVIDER=none
LLM_API_KEY=
AI_CONFIG_VERSION=matcher-v1
