# Copy to .env and adjust. Values below match docker-compose.yml.
# When running a service on your machine (npm run dev:*), use the "host" values.
# Inside Docker, compose overrides these with container hostnames.

NODE_ENV=development
JWT_SECRET=change-me-dev-secret
# Session token lifetime issued by POST /auth/login (default 8 hours)
JWT_EXPIRES_IN_SECONDS=28800

# Kafka (host listener on 9094; containers use kafka:9092)
KAFKA_BROKERS=localhost:9094

# MySQL (host port 3307 so it does not clash with a local MySQL on 3306)
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=airbnb
MYSQL_PASSWORD=airbnb
MYSQL_DATABASE=airbnb

# MongoDB (host port 27018 so it does not clash with a local MongoDB)
MONGO_URL=mongodb://localhost:27018
MONGO_DB=airbnb

# Redis
REDIS_URL=redis://localhost:6379

# Service ports
GATEWAY_PORT=8080
USER_SERVICE_PORT=8001
PROPERTY_SERVICE_PORT=8002
BOOKING_SERVICE_PORT=8003
MESSAGING_SERVICE_PORT=8004
REVIEW_SERVICE_PORT=8005
ANALYTICS_SERVICE_PORT=8006
AI_SERVICE_PORT=8007
NOTIFY_PORT=8009

# Admin account for the Platform and AI dashboards: run `npm run admin:create` once per database.
# It asks for the password without showing it. ADMIN_PASSWORD is only for unattended runs:
# set it in your own .env (git-ignored), never in this file or in a commit.
ADMIN_EMAIL=admin@staybook.test
ADMIN_NAME=Staybook Admin
ADMIN_PASSWORD=

# AI service
# none = deterministic, or ollama (run `ollama serve` and pull the model first)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://localhost:11434
LLM_TIMEOUT_S=15
AI_CONFIG_VERSION=matcher-v1
