{
  "name": "airbnb-platform",
  "private": true,
  "description": "Distributed Systems group project: Airbnb-style rental platform with Kafka and agentic AI",
  "workspaces": [
    "packages/common",
    "services/gateway",
    "services/user-service",
    "services/property-service",
    "services/booking-service",
    "services/messaging-service",
    "services/review-service",
    "services/analytics-service",
    "services/notification-gateway",
    "client"
  ],
  "scripts": {
    "infra:up": "docker compose up -d kafka kafka-init kafka-ui mysql mongo redis",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "test": "npm test --workspaces --if-present",
    "dev:gateway": "npm run dev -w services/gateway",
    "dev:user": "npm run dev -w services/user-service",
    "dev:property": "npm run dev -w services/property-service",
    "dev:booking": "npm run dev -w services/booking-service",
    "dev:booking-worker": "npm run worker -w services/booking-service",
    "dev:messaging": "npm run dev -w services/messaging-service",
    "dev:review": "npm run dev -w services/review-service",
    "dev:analytics": "npm run dev -w services/analytics-service",
    "dev:notify": "npm run dev -w services/notification-gateway",
    "dev:client": "npm run dev -w client",
    "smoke": "node scripts/smoke.js"
  },
  "engines": {
    "node": ">=22"
  }
}
