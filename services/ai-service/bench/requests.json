    {"id": "R01", "category": "text", "request_text": "A place in San Jose for two people under $250 a night with parking and a kitchen, rated at least 4.5",
     "expected": {"city": "San Jose", "guests": 2, "price_max": 250, "amenities": ["parking", "kitchen"], "min_rating": 4.5}},
    {"id": "R02", "category": "text", "request_text": "Looking for somewhere in San Francisco for 4 guests, max $400 per night, needs wifi",
     "expected": {"city": "San Francisco", "guests": 4, "price_max": 400, "amenities": ["wifi"]}},
    {"id": "R03", "category": "text", "request_text": "Oakland, 2 guests, under 200, washer please",
     "expected": {"city": "Oakland", "guests": 2, "price_max": 200, "amenities": ["washer"]}},
    {"id": "R04", "category": "text", "request_text": "Cabin-style stay in South Lake Tahoe for 6 people with heating, budget $350 a night",
     "expected": {"city": "South Lake Tahoe", "guests": 6, "price_max": 350, "amenities": ["heating"]}},
    {"id": "R05", "category": "text", "request_text": "Palo Alto for one person, a desk to work at, below $180",
     "expected": {"city": "Palo Alto", "guests": 1, "price_max": 180, "amenities": ["workspace"]}},
